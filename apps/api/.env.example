# INSTANCE_NAME=thirdeye-local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_TIMEOUT_SECONDS=5
LOG_LEVEL=info
PUBLIC_INSTANCE=false
REGION_BBOX=[-180, -90, 180, 90]
