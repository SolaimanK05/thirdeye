# FIRMS_MAP_KEY=
# AISSTREAM_API_KEY=
# FIRMS_MIN_CONFIDENCE=high
# FIRMS_MIN_FRP_MW=0
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# OPENSKY_BBOX=[-180, -90, 180, 90]
# BUDGET_OPENSKY_CREDITS_DAY=3800
# GOVERNOR_COOLDOWN_MIN_S=30
# GOVERNOR_COOLDOWN_MAX_S=1800
CORS_ORIGINS=["http://localhost:3000"]
LOG_FORMAT=pretty

