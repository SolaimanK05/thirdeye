# INSTANCE_NAME=thirdeye-local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_TIMEOUT_SECONDS=5
LOG_LEVEL=info
PUBLIC_INSTANCE=false
# Run the worker inside the API process instead of as its own (`make dev-worker`).
RUN_WORKER=false
REGION_BBOX=[-180, -90, 180, 90]
# Worldwide wildfires: REGION_BBOX=[-180, -90, 180, 90]
# MODULES_ENABLED=["earthquakes", "satellites", "ports", "wildfires", "aircraft", "vessels"]
# FIRMS_MAP_KEY=
# FIRMS_MIN_CONFIDENCE=high
# FIRMS_MIN_FRP_MW=0
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
# OPENSKY_BBOX=[-180, -90, 180, 90]
# BUDGET_OPENSKY_CREDITS_DAY=3800
# GOVERNOR_COOLDOWN_MIN_S=30
# GOVERNOR_COOLDOWN_MAX_S=1800
# AISSTREAM_API_KEY=
# AISSTREAM_BBOX=[-180, -90, 180, 90]
# AIS_BATCH_SECONDS=5
# AIS_QUEUE_MAX=10000
# SATELLITE_GROUP=active
# CELESTRAK_URL=
# SATCAT_URL=
CORS_ORIGINS=["http://localhost:3000"]
LOG_FORMAT=pretty

# Daily clean-up (the worker runs it at start and once a day).
# Events of modules that do not prune their own are kept this many days.
# RETENTION_EVENT_DAYS=7
# Fixes of starred ships and aircraft are kept this many hours (24 h replay + 1 h).
# RETENTION_STARRED_HOURS=25
# UTC hour of the daily run.
# RETENTION_HOUR_UTC=3

# Test tool: serve this many synthetic movers as the "synthetic" module of
# /v1/movers (binary frames only). Refused when PUBLIC_INSTANCE=true.
# SYNTHETIC_MOVERS=0
# SYNTHETIC_INTERVAL_SECONDS=1.0
# SYNTHETIC_SEED=1
